module tests

// The README's examples, against the test server: a count with a parameter, rows read by column and
// into a derived type, a unique violation's SQLSTATE, a transfer in a transaction, a pool, a batch,
// a statement cancelled by a timeout, and tracing.

import avin.threads.{Atomic, Mutex, withTimeout}
import avin.time.{millis, seconds}
import dev.avinlang.pg

import dev.avinlang.pg.{
  Batch, Connection, PgColumn, PgConfig, PgError, PgPool, FromRow, QueryEnd, QuerySpan, QueryStart, QueryTracer,
  SlowQueryLog
}

data ReadmeItem(id: int, @PgColumn("name") label: string, price: Option[BigDecimal] = None) derives FromRow

@test("the README's first example: a count with a parameter")
readmeCount() -> Result[unit, PgError]
  val db = testConnection() match
    Some(r) -> r?
    None -> return Ok(())
  val n = db.queryValue[long](
    "select count(*) from (values (50), (150), (300)) as orders(total) where total > $1",
    100
  )?
  assertEq(s"$n large orders", "2 large orders")
  db.close()

@test("the README's queries: parameters, NULL, rows read by column and into a derived type")
readmeQueries() -> Result[unit, PgError]
  val db = testConnection() match
    Some(r) -> r?
    None -> return Ok(())
  db.execute("create temporary table items (id int primary key, name text, price numeric)")?
  db.execute(
      "insert into items values ($1, $2, $3), ($4, $5, $6)",
      1,
      "pen",
      BigDecimal("1.50"),
      2,
      "ink",
      None: Option[BigDecimal]
  )?
  var lines: Vector[string] = []
  for row in db.query("select id, name, price from items order by id")?
    val name = row.get[string]("name")?
    val price = row.get[Option[BigDecimal]]("price")?
    lines = lines :+ s"$name: $price"
  assertEq(lines, ["pen: Some(1.50)", "ink: None"])
  val items = db.queryAs[ReadmeItem]("select id, name from items order by id")?
  assertEq(items, [ReadmeItem(1, "pen"), ReadmeItem(2, "ink")])
  db.close()

@test("the README's error example: a unique violation's SQLSTATE")
readmeErrors() -> Result[unit, PgError]
  val db = testConnection() match
    Some(r) -> r?
    None -> return Ok(())
  db.execute("create temporary table users (email text unique)")?
  db.execute("insert into users values ($1)", "ada@example.com")?
  var said = ""
  db.execute("insert into users values ($1)", "ada@example.com") match
    Err(e) -> if e.code == Some("23505") then said = "already registered"
    Ok(_) -> ()
  assertEq(said, "already registered")
  db.close()

@test("the README's transaction: a transfer committed")
readmeTransaction() -> Result[unit, PgError]
  val db = testConnection() match
    Some(r) -> r?
    None -> return Ok(())
  db.execute("create temporary table accounts (id int, balance int)")?
  db.execute("insert into accounts values (1, 100), (2, 0)")?
  db.transaction(tx ->
    tx.execute("update accounts set balance = balance - $1 where id = $2", 30, 1)?
    tx.execute("update accounts set balance = balance + $1 where id = $2", 30, 2)?
    Ok(()))?
  assertEq(db.query("select balance from accounts order by id")?.map(r -> r.get[int](0)), [Ok(70), Ok(30)])
  db.close()

@test("the README's pool: names read on a pooled connection")
readmePool() -> Result[unit, PgError]
  val url = testUrl() match
    Some(u) -> u
    None -> return Ok(())
  val pool = PgPool.open(url, maxSize = 8)?
  val names = pool.use(c -> c.query("select name from (values ('ada'), ('grace')) as customers(name)"))?
  assertEq(names.map(r -> r.get[string]("name")), [Ok("ada"), Ok("grace")])
  pool.close()
  Ok(())

data User(id: int, name: string) derives FromRow

@test("the README's batch: two inserts and a query sent together, read in order")
readmeBatch() -> Result[unit, PgError]
  val db = testConnection() match
    Some(r) -> r?
    None -> return Ok(())
  db.execute("create temporary table users (id int, name text)")?
  val batch = Batch()
    .queue("insert into users values ($1, $2)", 1, "ada")
    .queue("insert into users values ($1, $2)", 2, "grace")
    .queue("select id, name from users order by id")
  val r = db.sendBatch(batch)?.reader()
  val inserted = r.execute()? + r.execute()?
  val users = r.queryAs[User]()?
  assertEq(inserted, long(2))
  assertEq(users, [User(1, "ada"), User(2, "grace")])
  db.close()

// The README's tracer: each statement numbered, its start and end logged under that number.
class Numbered(private val log: @sendable (string) -> unit): Sendable
  val next = Atomic(long(0))

data NumberedSpan(n: long, log: @sendable (string) -> unit)

impl QueryTracer for Numbered
  queryStart(e: QueryStart) -> QuerySpan
    val n = next.add(1)
    log(s"#$n on backend ${e.pid}: ${e.sql}")
    NumberedSpan(n, log)

impl QuerySpan for NumberedSpan
  queryEnd(e: QueryEnd) = log(s"#$n: ${e.rows} rows, ${e.code.getOrElse("ok")}")

private record(lines: Mutex[Buffer[string]], line: string)
  lines.with(b ->
    b.addOne(line)
    ())

@test("the README's tracing: statements numbered from start to end, and the slow-query log")
readmeTracing() -> Result[unit, PgError]
  val url = testUrl() match
    Some(u) -> u
    None -> return Ok(())
  val lines = Mutex(Buffer[string]())
  val config = PgConfig.parse(url)?
  val db = PgPool.of(config with {queryTracer = Some(Numbered(line -> record(lines, line)))}, maxSize = 8)
  val pid = db.use(c -> Ok(c.backendPid))?
  db.query("select 1")?
  assert(db.query("select nothing_here").isErr)
  db.close()
  assertEq(
    lines.with(b -> b.toVector),
    [
      s"#1 on backend $pid: select 1",
      "#1: 1 rows, ok",
      s"#2 on backend $pid: select nothing_here",
      "#2: 0 rows, 42703"
    ]
  )
  val slow = Mutex(Buffer[string]())
  val logged = config with {queryTracer = Some(SlowQueryLog(millis(250), line -> record(slow, line)))}
  val c = pg.connect(logged)?
  c.query("select pg_sleep(0.3)")?
  c.query("select 1")?
  assertEq(slow.with(b -> b.length), 1)
  assert(slow.with(b -> b(0)).endsWith(s"on backend ${c.backendPid}, 1 rows: select pg_sleep(0.3)"))
  c.close()

@test("the README's cancellation: a statement past its time is cancelled")
readmeCancel() -> Result[unit, PgError]
  val db = testConnection() match
    Some(r) -> r?
    None -> return Ok(())
  val r = withTimeout(seconds(2), _ -> db.query("select pg_sleep(60)"))
  assert(r.isEmpty)
  assertEq(db.queryValue[int]("select 1"), Ok(1))
  db.close()
