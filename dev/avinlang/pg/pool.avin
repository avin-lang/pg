module dev.avinlang.pg

// `Atomic` is also `BatchMode`'s variant in this module, so the thread library's cell is renamed.
import avin.threads.{
  AcquireTimedOut,
  Atomic as AtomicCell,
  Channel,
  CreateFailed,
  Lease,
  Pool,
  PoolError,
  QueueFull,
  Thread,
  spawn
}

import avin.time.{Duration, monotonic, seconds}

// Connections shared between threads: `use(f)` lends one to `f` and takes it back when `f` returns,
// however it returns. A connection is made when one is asked for and none is idle, up to `maxSize`;
// one handed back broken, or found broken or closed while it waited, is let go and another made in
// its place. A connection handed back inside a transaction, `f` having begun one and not ended it, is
// rolled back first, so the next user finds it clean.
//
//     val db = PgPool.open(url, maxSize = 8)?
//     val names = db.use(c -> c.query("select name from users"))?
//
// Every wait parks only the calling lightweight thread, so thousands of threads may share a pool of
// a few connections: callers waiting for a connection are served in the order they came. A caller
// waits at most the pool's `acquireTimeout`, or the time its `use` gives, and fails with
// `PoolTimedOut`; where `maxWaiting` callers already wait, one more fails at once with `PoolBusy`,
// which a server answers with 503. A connection is retired once it is older than `maxLifetime`, or
// has been idle longer than `idleTimeout` (keeping `minIdle`), each lengthened by the connection's own
// random part of `jitter` so connections made together are not all replaced together. A connection
// idle for at least `pingAfter` is pinged before it is lent, and one that does not answer within
// `pingTimeout` is let go and another found. Every `healthCheck`, a thread of the pool's own retires
// the connections past their limits and makes connections until the pool holds `minIdle`, which it
// also does as soon as the pool is opened.
//
// A pool may be shared between threads and actors. `use`'s body is isolated, as a `Pool`'s is: it
// gives back a sendable value, rows among them, and keeps nothing of the connection.
// The configuration's `poolTracer` is told of every connection lent and given back.
class PgPool(
    private val pool: Pool[Connection, PgError],
    private val stop: Channel[unit],
    private val keeper: Option[Thread[unit]],
    private val tracer: Option[PoolTracer] = None
): Sendable
  // Runs `f` with a connection lent to it, waiting for one for at most the pool's `acquireTimeout`,
  // or until the calling thread's deadline, and answers what `f` answers.
  use[R: Sendable](@isolating f: (Connection) -> Result[R, PgError]) -> Result[R, PgError] = leased(None, f)

  // `use(f)`, waiting for a connection for at most `timeout`.
  use[R: Sendable](timeout: Duration, @isolating f: (Connection) -> Result[R, PgError]) -> Result[R, PgError] =
    leased(Some(timeout), f)

  // Runs `f` in a transaction on a pooled connection (`Connection.transaction`).
  transaction[R: Sendable](@isolating f: (Connection) -> Result[R, PgError]) -> Result[R, PgError] =
    leased(None, c -> c.transaction(f))

  // The rows `sql` returns, run on a pooled connection.
  query(sql: string, params: ToPg*) -> Result[Vector[Row], PgError] = leased(None, c -> c.query(sql, params*))

  // Runs `sql` on a pooled connection and answers how many rows it touched.
  execute(sql: string, params: ToPg*) -> Result[long, PgError] = leased(None, c -> c.execute(sql, params*))

  // Lends a connection to `f`, waiting for at most `timeout`, or the pool's `acquireTimeout` where it
  // is `None`. Where the calling thread's deadline has already passed, nothing is asked of the pool, no
  // tracer is told, and the answer is `DeadlinePassed`; one that passes while the caller waits cancels
  // the wait.
  private leased[R: Sendable](
      timeout: Option[Duration],
      @isolating f: (Connection) -> Result[R, PgError]
  ) -> Result[R, PgError]
    beforeDeadline()?
    tracer match
      None -> flattened(leaseFor(timeout, l -> lent(l, f)))
      Some(t) -> tracedLease(t, timeout, f)

  private leaseFor[R: Sendable](
      timeout: Option[Duration],
      @isolating f: (Lease[Connection]) -> R
  ) -> Result[R, PoolError[PgError]] = timeout match
    Some(d) -> pool.lease(d, f)
    None -> pool.lease(f)

  // `leased`, with `t` told of the wait, the connection lent and its return. The lease's own `defer`
  // readies the connection before `released` is told whether the pool keeps it.
  private tracedLease[R: Sendable](
      t: PoolTracer,
      timeout: Option[Duration],
      @isolating f: (Connection) -> Result[R, PgError]
  ) -> Result[R, PgError]
    val id = currentRequestId()
    val span = t.acquireStart()
    val asked = monotonic()
    // Set by the lease's body, which may capture only sendable values.
    val ended = AtomicCell(false)
    defer
      if !ended.load() then span.acquireEnd(AcquireEnd(monotonic() - asked, 0, None, true, id))
    val result = leaseFor(timeout, l ->
      ended.store(true)
      val pid = l.resource.backendPid
      span.acquireEnd(AcquireEnd(monotonic() - asked, pid, None, false, id))
      val since = monotonic()
      defer span.released(Released(monotonic() - since, pid, l.isBroken, id))
      lent(l, f))
    result match
      Ok(inner) -> inner
      Err(e) ->
        ended.store(true)
        val failure = poolFailure(e)
        span.acquireEnd(AcquireEnd(monotonic() - asked, 0, Some(failure), false, id))
        Err(failure)

  // Runs the statements of `batch` together on a pooled connection (`Connection.sendBatch`).
  sendBatch(batch: Batch, mode: BatchMode = Atomic) -> Result[BatchResults, PgError] =
    leased(None, c -> c.sendBatch(batch, mode))

  // Makes connections until the pool holds its `minIdle`.
  warm() -> Result[unit, PgError] = pool.warm().mapErr(poolFailure)

  // What the pool holds now, and what it has done since it was opened.
  stats() -> PgPoolStats
    val now = pool.stats()
    val c = pool.counters()
    PgPoolStats(
      now.size,
      now.idle,
      now.lent,
      now.waiting,
      c.acquires,
      c.waited,
      c.waitTime,
      c.timeouts,
      c.rejected,
      c.created,
      c.destroyed
    )

  // Closes the pool: its health check stops, idle connections are closed now, and lent ones as they
  // come back.
  close()
    stop.close()
    if keeper is Some(k) then k.join()
    pool.close()

// What a pool holds and has done: `total` connections, made or being made, of which `idle` wait to
// be lent and `inUse` are lent now, with `waiting` callers waiting for one; and since the pool was
// opened, `acquires` connections lent, `waited` of them after waiting, taking `waitTime` in all from
// the call to the lending, connecting and pinging included; `timeouts` callers whose time ran out and
// `rejected` turned away with `PoolBusy`; and `created` connections made and `destroyed` closed.
data PgPoolStats(
    total: int,
    idle: int,
    inUse: int,
    waiting: int,
    acquires: long,
    waited: long,
    waitTime: Duration,
    timeouts: long,
    rejected: long,
    created: long,
    destroyed: long
)

object PgPool
  // A pool of connections made with the settings of the URL `url`. Nothing is connected until a
  // connection is first asked for, `warm` is called, or the health check makes the `minIdle`.
  open(
      url: string,
      maxSize: int = 10,
      minIdle: int = 0,
      idleTimeout: Option[Duration] = Some(seconds(1800)),
      acquireTimeout: Option[Duration] = None,
      maxLifetime: Option[Duration] = Some(seconds(3600)),
      jitter: Option[Duration] = None,
      maxWaiting: Option[int] = None,
      pingAfter: Option[Duration] = Some(seconds(1)),
      pingTimeout: Duration = seconds(5),
      healthCheck: Option[Duration] = Some(seconds(60))
  ) -> Result[PgPool, PgError] = Ok(
    PgPool.of(
      PgConfig.parse(url)?,
      maxSize,
      minIdle,
      idleTimeout,
      acquireTimeout,
      maxLifetime,
      jitter,
      maxWaiting,
      pingAfter,
      pingTimeout,
      healthCheck
    )
  )

  // A pool of connections made with `config`.
  of(
      config: PgConfig,
      maxSize: int = 10,
      minIdle: int = 0,
      idleTimeout: Option[Duration] = Some(seconds(1800)),
      acquireTimeout: Option[Duration] = None,
      maxLifetime: Option[Duration] = Some(seconds(3600)),
      jitter: Option[Duration] = None,
      maxWaiting: Option[int] = None,
      pingAfter: Option[Duration] = Some(seconds(1)),
      pingTimeout: Duration = seconds(5),
      healthCheck: Option[Duration] = Some(seconds(60))
  ) -> PgPool
    val pool = Pool[Connection, PgError](
      () -> connect(config),
      maxSize,
      minIdle,
      validate = Some(c -> lendable(c, pingAfter, pingTimeout)),
      destroy = Some(c -> discard(c)),
      idleTimeout = idleTimeout,
      acquireTimeout = acquireTimeout,
      maxLifetime = maxLifetime,
      jitter = jitter,
      maxWaiting = maxWaiting
    )
    val stop = Channel[unit]()
    val keeper = healthCheck.map(every -> spawn(() -> keep(pool, stop, every)))
    PgPool(pool, stop, keeper, config.poolTracer)

// Whether the idle connection `c` may be lent: it is healthy, and where it has been idle for at least
// `pingAfter`, it answers a ping within `pingTimeout`.
private lendable(c: Connection, pingAfter: Option[Duration], pingTimeout: Duration) -> bool
  if !c.isHealthy then return false
  pingAfter match
    Some(after) if c.idleFor >= after -> c.ping(pingTimeout).isOk
    _ -> true

// The pool's health check: makes the `minIdle` at once, then every `every` until `stop` is closed
// retires the connections past their limits and makes the `minIdle` again. A connection it cannot
// make is tried again at the next check.
private keep(pool: Pool[Connection, PgError], stop: Channel[unit], every: Duration)
  _ = pool.warm()
  while stop.receive(every).isEmpty && !stop.isClosed()
    _ = pool.evictIdle()
    _ = pool.warm()

private discard(c: Connection)
  _ = c.close()

// Runs `f` with the lent connection, then readies the connection for the pool: a broken one is
// marked so the pool lets it go, and one left in a transaction is rolled back. It runs when `f` is
// cancelled too.
private lent[R](l: Lease[Connection], @isolating f: (Connection) -> Result[R, PgError]) -> Result[R, PgError]
  defer handBack(l)
  f(l.resource)

private handBack(l: Lease[Connection])
  val c = l.resource
  if c.isBroken || c.isClosed then l.markBroken()
  elif c.reset().isErr then l.markBroken()

private flattened[R](r: Result[Result[R, PgError], PoolError[PgError]]) -> Result[R, PgError] = r match
  Ok(inner) -> inner
  Err(e) -> Err(poolFailure(e))

// What a caller is told of a lease that failed. A connection that could not be made because the
// server could not be reached, or was starting up or shutting down, is `NotSent`: the caller's
// statement never left. A refusal that will not pass by itself, a password the server rejects among
// them, is answered as it is.
private poolFailure(e: PoolError[PgError]) -> PgError = e match
  AcquireTimedOut -> PoolTimedOut
  QueueFull -> PoolBusy
  PoolError.PoolClosed -> PoolClosed
  CreateFailed(inner) -> if unreachable(inner) then NotSent(inner) else inner

// Whether a failure to connect says the server could not be reached for now: the connection failed
// or timed out, or the server answered that it is starting up or shutting down (SQLSTATE class 57P)
// or that it cannot take the connection (class 08).
private unreachable(e: PgError) -> bool = e match
  Io(_) -> true
  Server(d) -> d.code.startsWith("57P") || d.code.startsWith("08")
  _ -> false
