module dev.avinlang.pg

// A connection to the server: startup and authentication, the simple and the extended query
// protocols, a cache of prepared statements, transactions, and cancelling a statement whose thread
// is cancelled.

import avin.io
import avin.io.IoError
import avin.net.{ByteStream, TcpStream}
import avin.net.tls.{TlsClient, TlsStream}
import avin.time.{Duration, seconds}

// A statement prepared on a connection: its name there, its text, the types of its parameters as
// the server settled them, and the columns its rows have (none for a statement that returns no
// rows). `Connection.prepare` makes one; it belongs to the connection that prepared it.
data Statement(name: string, sql: string, paramOids: Vector[int], columns: Vector[Column])

// What one statement of a simple query produced: its command tag (`SELECT 2`, `INSERT 0 1`,
// `CREATE TABLE`) and its rows, empty for a statement that returns none.
data QueryResult(tag: string, rows: Vector[Row])

impl QueryResult
  // The rows the command touched, as its tag counts them: those inserted, updated, deleted, selected
  // or copied; 0 for a command whose tag has no count.
  affected -> long = affectedBy(tag)

private affectedBy(tag: string) -> long
  val space = tag.lastIndexOf(" ")
  if space < 0 then 0 else tag.slice(space + 1, tag.byteLength).toLongOption().getOrElse(0)

// A value sent as the type `oid` names, `0` leaving the type to the server: `Typed(3802,
// PgText("{}"))` sends text as `jsonb`. Every parameter is bound as one, and since it is plain data
// it can be handed to another thread.
data Typed(oid: int, value: PgValue)

impl ToPg for Typed
  toPg -> PgValue = value
  pgOid -> int = oid

// `p` as it is bound.
private paramOf(p: ToPg) -> Typed = Typed(p.pgOid, p.toPg)

// How long cancelling a statement and reading what the server still sends for it may wait before the
// connection is given up as broken.
private val DrainLimit: Duration = 30.seconds

// How many bytes of a batch are sent ahead of the answers read: well under what a socket's buffers
// hold at either end, so the server, which stops reading while it cannot write, never leaves a write
// of the client's waiting.
private val PipelineWindow = 32768

// A distinct statement a batch runs: its cache key (empty for a statement the program prepared), its
// text and parameter types, and the statement itself where it is already prepared.
private data Plan(key: string, sql: string, oids: Vector[int], known: Option[Statement])

// The SSLRequest and CancelRequest codes, which take the place of a startup message's version.
private val SslRequestCode = 80877103
private val CancelRequestCode = 80877102
private val ProtocolVersion = 196608

// The statement cache's key for `sql` prepared with parameters of types `oids`.
private cacheKey(sql: string, oids: Vector[int]) -> string = oids.mkString(",") + ";" + sql

// A connection to a PostgreSQL server, made by `connect`. It runs one statement at a time; a pool
// shares connections between threads. Statements run through `query` and `execute` are prepared
// once and kept, up to the configuration's `statementCacheSize`, and run again by name.
//
// Where the thread running a statement is cancelled, the connection asks the server to cancel it
// (a CancelRequest on a connection of its own) and reads what the server still sends until it is
// ready again, so the connection can be used on; where that fails the connection is broken, and
// `isBroken` says so. A transaction a cancellation stops is rolled back.
class Connection(
  private var stream: ByteStream,
  private val config: PgConfig,
  // Whether the connection is encrypted.
  val isTls: bool
)
  private var reader = MessageReader(stream)
  private var pid = 0
  private var secret = 0
  // The transaction status of the last ReadyForQuery: `I` idle, `T` in a transaction, `E` in a
  // failed one.
  private var status = 'I'
  private var broken = false
  private var closed = false
  // Set while a request's answer is being read, so a cancellation in the middle knows to drain it.
  private var awaiting = false
  // While an answer is being read: how many ReadyForQuery messages are still owed, one for each Sync
  // or simple query sent, and whether messages have been sent since the last Sync.
  private var owed = 0
  private var unsynced = false
  // Set while bytes are being written, so a cancellation in the middle of a write knows the stream
  // may hold half a message.
  private var writing = false
  private var parameters = HashMap.empty[string, string]()
  private var cache = HashMap.empty[string, Statement]()
  // Cache keys, the least recently used first.
  private var order: Vector[string] = []
  // Cached statements evicted and not yet closed on the server.
  private var evicted: Vector[string] = []
  private var counter = 0
  // How many transactions and savepoints are open.
  private var depth = 0
  private var auth: AuthMethod = Trust

  // How the server had this connection authenticate.
  authMethod -> AuthMethod = auth

  // The server process serving this connection, as `pg_backend_pid()` names it.
  backendPid -> int = pid

  // A setting the server reported: `server_version`, `TimeZone`, `client_encoding` and others.
  parameter(name: string) -> Option[string] = parameters.get(name)

  // Whether the connection broke and cannot be used again.
  isBroken -> bool = broken

  // Whether the connection is closed.
  isClosed -> bool = closed

  // Whether a transaction is open, a failed one included.
  inTransaction -> bool = status != 'I'

  // How many statements the connection keeps prepared.
  cachedStatements -> int = cache.size

  // ---- Running statements ----

  // The rows `sql` returns, its parameters `$1`, `$2`… bound to `params`.
  query(sql: string, params: ToPg*) -> Result[Vector[Row], PgError] = run(sql, params.map(paramOf)).map(r -> r.rows)

  // The rows a prepared statement returns.
  query(statement: Statement, params: ToPg*) -> Result[Vector[Row], PgError] =
    runStatement(statement, params.map(paramOf)).map(r -> r.rows)

  // The first row `sql` returns, or `None` where it returns none.
  queryOne(sql: string, params: ToPg*) -> Result[Option[Row], PgError] =
    run(sql, params.map(paramOf)).map(r -> r.rows.headOption)

  // The rows `sql` returns, each read as a `T`.
  queryAs[T: FromRow](sql: string, params: ToPg*) -> Result[Vector[T], PgError]
    val rows = run(sql, params.map(paramOf))?.rows
    val out = Buffer[T]()
    for row in rows
      out.addOne(T.fromRow(row)?)
    Ok(out.toVector)

  // The first column of the first row `sql` returns, read as a `T`; a statement that returns no row
  // is a `Column` error.
  queryValue[T: FromPg](
      sql: string,
      params: ToPg*
  ) -> Result[T, PgError] = run(sql, params.map(paramOf))?.rows.headOption match
    Some(row) -> row.get[T](0)
    None -> Err(BadColumn("#0", "the statement returned no rows"))

  // Runs `sql` and answers how many rows it touched, as its command tag counts them.
  execute(
      sql: string,
      params: ToPg*
  ) -> Result[long, PgError] = run(sql, params.map(paramOf)).map(r -> affectedBy(r.tag))

  // Runs a prepared statement and answers how many rows it touched.
  execute(statement: Statement, params: ToPg*) -> Result[long, PgError] =
    runStatement(statement, params.map(paramOf)).map(r -> affectedBy(r.tag))

  // Prepares `sql` under a name of its own, its parameters' types inferred by the server. The
  // statement stays prepared until the connection closes or `deallocate` closes it.
  prepare(sql: string) -> Result[Statement, PgError]
    counter += 1
    parse(s"pgp_$counter", sql, [])

  // Closes a prepared statement on the server.
  deallocate(statement: Statement) -> Result[unit, PgError]
    usable()?
    val out = Out()
    out.begin('C').byte1(int('S')).cstring(statement.name).close()
    out.begin('S').close()
    exchange(out, (_, _) -> Ok(()))?
    Ok(())

  // Runs `sql` with the simple query protocol: several statements separated by `;`, no parameters,
  // every value sent as text. Each statement's result is answered in order.
  simpleQuery(sql: string) -> Result[Vector[QueryResult], PgError] = config.queryTracer match
    None -> simpleUntraced(sql)
    Some(t) -> tracedQuery(t, sql, [], false, pid, () -> simpleUntraced(sql), rs ->
      (rs.map(rowsOf).sum, rs.lastOption.map(r -> r.tag).getOrElse("")))

  private simpleUntraced(sql: string) -> Result[Vector[QueryResult], PgError]
    usable()?
    val out = Out()
    out.begin('Q').cstring(sql).close()
    val results = Buffer[QueryResult]()
    var columns: Vector[Column] = []
    var rows = Buffer[Row]()
    exchange(out, (m, failed) ->
      m.kind match
        'T' -> columns = describe(m)?.map(c -> c.0)
        'D' -> if !failed then rows.addOne(textRow(columns, m)?)
        'C' ->
          results.addOne(QueryResult(In(m.body).cstring(), rows.toVector))
          rows = Buffer[Row]()
          columns = []
        'I' -> ()
        'G' -> send(Out().begin('f').cstring("COPY is not supported by this client").close())?
        'H' | 'd' | 'c' -> ()
        _ -> return Err(Protocol(s"unexpected message `${m.kind}` answering a query"))
      Ok(()))?
    Ok(results.toVector)

  // Runs `f` in a transaction: `BEGIN` first, then `COMMIT` where `f` answers `Ok`, and `ROLLBACK`
  // where it answers `Err`, or where the thread running it is cancelled. Inside another
  // transaction it is a savepoint, released or rolled back to in the same way, so transactions nest.
  // A transaction a failed statement left aborted is rolled back even where `f` answers `Ok`, and
  // answers `RolledBack`.
  transaction[T](f: (Connection) -> Result[T, PgError]) -> Result[T, PgError]
    val level = depth
    val savepoint = s"pg_savepoint_$level"
    simple(if level == 0 then "BEGIN" else s"SAVEPOINT $savepoint")?
    depth = level + 1
    var settled = false
    defer
      if !settled then abandon(level)
    val result = f(self)
    settled = true
    depth = level
    result match
      Ok(v) ->
        if status == 'E'
          rollback(level)?
          return Err(RolledBack)
        simple(if level == 0 then "COMMIT" else s"RELEASE SAVEPOINT $savepoint")?
        Ok(v)
      Err(e) ->
        _ = rollback(level)
        Err(e)

  // Rolls back the transaction or savepoint opened at `level`.
  private rollback(level: int) -> Result[unit, PgError] =
    if level == 0 then simple("ROLLBACK")
    else simple(s"ROLLBACK TO SAVEPOINT pg_savepoint_$level; RELEASE SAVEPOINT pg_savepoint_$level")

  // After a cancellation inside a transaction: rolls back to before it, or gives the connection up.
  private abandon(level: int)
    depth = level
    if broken || closed then return
    if rollback(level).isErr then broken = true

  // Rolls back whatever transaction is open, savepoints and all; a pool does this to every
  // connection given back.
  reset() -> Result[unit, PgError]
    depth = 0
    if status == 'I' then return Ok(())
    simple("ROLLBACK")

  // Whether the connection can be used at once: it is open, not broken, in no transaction, and the
  // server has sent nothing unasked, as it does when it ends the session.
  isHealthy -> bool = !closed && !broken && status == 'I' && !stream.readable()

  // Says goodbye to the server and closes the connection. Closing a closed connection does nothing.
  close() -> Result[unit, PgError]
    if closed then return Ok(())
    closed = true
    if !broken then _ = stream.write(Out().begin('X').close().toArray())
    stream.close().mapErr(e -> Io(e))

  // ---- Batches ----

  // Runs the statements queued in `batch`, sent together rather than a round trip each, and answers
  // each one's result in the order they were queued. Statements not yet prepared are prepared first,
  // together, in one more round trip, and kept in the statement cache.
  //
  // `Atomic`, the default, runs the statements as one implicit transaction: a statement that fails
  // answers its error, those after it are not run and answer `Skipped`, and what those before it did
  // is rolled back. `Independent` runs each statement as a transaction of its own, so a failure is
  // that statement's alone. Inside `transaction(f)` the statements belong to that transaction either
  // way, and a failure leaves it failed. The answer is an `Err` only where the batch could not be run
  // at all: the connection is closed, or broke.
  //
  // The configuration's `batchTracer` is told the batch starts, then each statement's outcome in
  // order once the batch has been read, then its end.
  sendBatch(batch: Batch, mode: BatchMode = Atomic) -> Result[BatchResults, PgError] = config.batchTracer match
    None -> runBatch(batch, mode)
    Some(t) -> tracedBatch(t, batch, pid, () -> runBatch(batch, mode))

  private runBatch(batch: Batch, mode: BatchMode) -> Result[BatchResults, PgError]
    usable()?
    if batch.isEmpty then return Ok(BatchResults([]))
    val wasIdle = status == 'I'
    val (results, stale) = pipelined(batch.items, mode)?
    // A cached statement the server no longer accepts failed a batch that kept nothing, so the batch
    // is run again, the statement prepared afresh.
    if stale && mode == Atomic && wasIdle && status == 'I' then return pipelined(batch.items, mode).map(r -> r.0)
    Ok(results)

  // Prepares the statements `items` need that are not prepared, then runs the items; answers their
  // results, and whether a cached statement among them was refused as stale, and so dropped from the
  // cache.
  private pipelined(items: Vector[BatchItem], mode: BatchMode) -> Result[(BatchResults, bool), PgError]
    awaiting = true
    owed = 0
    unsynced = false
    defer
      if awaiting && !broken then recover()
    // One plan for each distinct statement, and the plan each item runs.
    val plans = Buffer[Plan]()
    val planOf = Buffer[int]()
    var keys = HashMap.empty[string, int]()
    for item in items
      item.statement match
        Some(s) ->
          plans.addOne(Plan("", s.sql, [], Some(s)))
          planOf.addOne(plans.length - 1)
        None ->
          val oids = item.params.map(p -> p.oid)
          val key = cacheKey(item.sql, oids)
          keys.get(key) match
            Some(i) -> planOf.addOne(i)
            None ->
              val known = cache.get(key)
              if known.isDefined then order = order.filter(k -> k != key) :+ key
              keys = keys.updated(key, plans.length)
              planOf.addOne(plans.length)
              plans.addOne(Plan(key, item.sql, oids, known))
    val statements = prepared(plans.toVector)?
    // Each item's messages, or why it cannot be sent. An item whose statement could not be prepared,
    // perhaps because it names a table an earlier item makes, is sent unprepared, its parameters as
    // text: where it fails, it fails where it stands among the others.
    val results = Buffer[Result[QueryResult, PgError]]()
    val sent = Buffer[(int, Option[Statement])]()
    val units = Buffer[Vector[byte]]()
    var refused = false
    for i in 0 ..< items.length
      results.addOne(Err(Skipped))
      if !refused
        val out = Out()
        val statement = statements(planOf(i))
        val made = statement match
          Some(s) -> bindAndExecute(out, s, items(i).params)
          None -> parseAndExecute(out, plans(planOf(i)), items(i).params)
        made match
          Ok(_) ->
            if mode == Independent then out.begin('S').close()
            units.addOne(out.toVector())
            sent.addOne((i, statement))
          Err(e) ->
            results(i) = Err(e)
            // One that cannot be sent fails an atomic batch before any of it runs.
            if mode == Atomic then refused = true
    var stale = false
    if !refused
      pipeline(units.toVector, mode == Independent, u ->
        val (i, s) = sent(u)
        val r = executed(s, mode == Independent)?
        results(i) = r
        r match
          Err(Server(d)) ->
            val plan = plans(planOf(i))
            if isStale(d) && plan.key != ""
              forget(plan.key)
              stale = true
          _ -> ()
        Ok(r.isOk || mode == Independent))?
    awaiting = false
    while order.length > config.statementCacheSize
      forget(order(0))
    Ok((BatchResults(results.toVector), stale))

  // The statement for each of `plans`: the one already prepared, or the one prepared now, together,
  // each Parse and Describe with a Sync of its own, so one the server refuses is refused alone; or
  // `None` where the server refuses it. Inside a transaction the preparing is done in a savepoint,
  // rolled back to after it, so a refusal does not leave the transaction failed. What is prepared now
  // is cached, or, where the cache holds nothing, closed with the next statement prepared.
  private prepared(plans: Vector[Plan]) -> Result[Vector[Option[Statement]], PgError]
    val statements = Buffer[Option[Statement]]()
    val fresh = Buffer[int]()
    val names = Buffer[string]()
    val units = Buffer[Vector[byte]]()
    val guarded = status == 'T'
    if guarded then units.addOne(Out().begin('Q').cstring("SAVEPOINT pg_batch").close().toVector())
    for p in plans
      p.known match
        Some(s) -> statements.addOne(Some(s))
        None ->
          counter += 1
          val name = if config.statementCacheSize == 0 then s"pgb_$counter" else s"pgs_$counter"
          val out = Out()
          if names.length == 0
            for old in evicted
              out.begin('C').byte1(int('S')).cstring(old).close()
            evicted = []
          out.begin('P').cstring(name).cstring(p.sql).int16(p.oids.length)
          for oid in p.oids
            out.int32(oid)
          out.close()
          out.begin('D').byte1(int('S')).cstring(name).close()
          out.begin('S').close()
          fresh.addOne(statements.length)
          names.addOne(name)
          units.addOne(out.toVector())
          statements.addOne(None)
    if names.length == 0 then return Ok(statements.toVector)
    if guarded then units.addOne(
      Out().begin('Q').cstring("ROLLBACK TO SAVEPOINT pg_batch; RELEASE SAVEPOINT pg_batch").close().toVector()
    )
    val first = if guarded then 1 else 0
    pipeline(units.toVector, true, u ->
      val j = u - first
      if 0 <= j < names.length
        statements(fresh(j)) = described(names(j), plans(fresh(j)).sql)?
      else
        queried()?
      Ok(true))?
    for j in 0 ..< fresh.length
      val key = plans(fresh(j)).key
      statements(fresh(j)) match
        Some(s) ->
          if config.statementCacheSize == 0
            evicted = evicted :+ s.name
          else
            cache = cache.updated(key, s)
            order = order :+ key
        None -> evicted = evicted :+ names(j)
    Ok(statements.toVector)

  // Reads the answer to a simple query up to its ReadyForQuery, its rows and its errors let go.
  private queried() -> Result[unit, PgError]
    while true
      val m = receive()?
      m.kind match
        'Z' ->
          ready(m)
          return Ok(())
        'C' | 'E' | 'T' | 'D' | 'I' -> ()
        _ -> return broke(Protocol(s"unexpected message `${m.kind}` answering a query"))
    Ok(())

  // Sends `units` a window at a time and gives the index of each to `answer` to read its answer,
  // which says whether to go on. A window is as many units as fit in `PipelineWindow` bytes, one at
  // least, and the next is sent only once every answer to the last is read: the server stops reading
  // while it cannot write, so the bytes sent ahead of what is read are kept below what the sockets
  // between the two ends can hold. Units `synced` end with a Sync of their own; the others are
  // followed by a Flush between windows and a Sync after the last, or after the one whose answer
  // stops them, the rest not being sent.
  private pipeline(
      units: Vector[Vector[byte]],
      synced: bool,
      answer: (int) -> Result[bool, PgError]
  ) -> Result[unit, PgError]
    var next = 0
    var done = 0
    while done < units.length
      val out = Out()
      while next < units.length && (next == done || out.length + units(next).length <= PipelineWindow)
        out.raw(units(next))
        next += 1
      val last = next == units.length
      if synced
        owed += next - done
      else
        out.begin(if last then 'S' else 'H').close()
        if last then owed += 1
        unsynced = !last
      send(out)?
      while done < next
        if !answer(done)?
          if unsynced
            send(Out().begin('S').close())?
            unsynced = false
            owed += 1
          return settle()
        done += 1
    settle()

  // Reads the answer to a Parse and Describe of `name`, up to its ReadyForQuery: the statement, or
  // `None` where the server refused it.
  private described(name: string, sql: string) -> Result[Option[Statement], PgError]
    var paramOids: Vector[int] = []
    var columns: Vector[Column] = []
    var failed = false
    while true
      val m = receive()?
      m.kind match
        '1' | '3' | 'n' -> ()
        't' ->
          val r = In(m.body)
          val n = r.int16()
          paramOids = Vector.tabulate(n, _ -> r.int32())
        'T' -> describe(m) match
          Ok(cs) -> columns = cs.map(c -> c.0)
          Err(e) -> return broke(e)
        'E' -> failed = true
        'Z' ->
          ready(m)
          return Ok(if failed then None else Some(Statement(name, sql, paramOids, columns)))
        _ -> return broke(Protocol(s"unexpected message `${m.kind}` answering Parse"))
    Err(Protocol("unreachable"))

  // Reads the answer to a Bind and Execute of `statement`, or, where it is `None`, to a Parse, Bind,
  // Describe and Execute of an unprepared one: its rows and command tag, or the server's error; and,
  // where `synced`, the ReadyForQuery after it.
  private executed(statement: Option[Statement], synced: bool) -> Result[Result[QueryResult, PgError], PgError]
    val rows = Buffer[Row]()
    var columns = statement.map(s -> s.columns).getOrElse([])
    var answer: Option[Result[QueryResult, PgError]] = None
    while answer.isEmpty
      val m = receive()?
      m.kind match
        '1' | '2' | 'n' -> ()
        'T' -> describe(m) match
          Ok(cs) -> columns = cs.map(c -> c.0)
          Err(e) -> return broke(e)
        'D' ->
          val row = if statement.isDefined then binaryRow(columns, m) else textRow(columns, m)
          row match
            Ok(r) -> rows.addOne(r)
            Err(e) -> return broke(e)
        'C' -> answer = Some(Ok(QueryResult(In(m.body).cstring(), rows.toVector)))
        'I' -> answer = Some(Ok(QueryResult("", [])))
        'E' -> answer = Some(Err(Server(diagnosticOf(m))))
        _ -> return broke(Protocol(s"unexpected message `${m.kind}` answering Execute"))
    if synced then settleOne()?
    Ok(answer.get)

  // Reads the ReadyForQuery that ends the answer just read.
  private settleOne() -> Result[unit, PgError]
    val m = receive()?
    if m.kind != 'Z' then return broke(Protocol(s"unexpected message `${m.kind}` before ReadyForQuery"))
    ready(m)
    Ok(())

  // Reads every ReadyForQuery still owed.
  private settle() -> Result[unit, PgError]
    while owed > 0
      settleOne()?
    Ok(())

  // A ReadyForQuery read: the transaction status it reports, and one fewer owed.
  private ready(m: Message)
    status = char(In(m.body).byte1())
    owed -= 1

  // ---- The extended protocol ----

  // Runs `sql` through the statement cache, retrying once a statement the server no longer accepts
  // (its table changed under it) where no transaction would be lost.
  private run(sql: string, params: Vector[Typed]) -> Result[QueryResult, PgError] = config.queryTracer match
    None -> runCached(sql, params)
    Some(t) -> tracedQuery(t, sql, params, config.traceParameters, pid, () -> runCached(sql, params), r ->
      (rowsOf(r), r.tag))

  // `runPrepared`, traced as a query.
  private runStatement(statement: Statement, params: Vector[Typed]) -> Result[QueryResult, PgError] =
    config.queryTracer match
      None -> runPrepared(statement, params)
      Some(t) ->
        tracedQuery(t, statement.sql, params, config.traceParameters, pid, () -> runPrepared(statement, params), r ->
          (rowsOf(r), r.tag))

  private runCached(sql: string, params: Vector[Typed]) -> Result[QueryResult, PgError]
    usable()?
    val statement = statementFor(sql, params)?
    runPrepared(statement, params) match
      Err(Server(d)) ->
        if isStale(d) && statement.name != ""
          forget(cacheKey(sql, params.map(p -> p.oid)))
          if status == 'I' then return runPrepared(statementFor(sql, params)?, params)
        Err(Server(d))
      other -> other

  // Whether the server refused a cached statement because what it prepared no longer holds.
  private isStale(d: Diagnostic) -> bool =
    d.code == "26000" || (d.code == "0A000" && d.message.contains("cached plan"))

  // The cached statement for `sql` with parameters of `params`' types, prepared now where it is not
  // cached.
  private statementFor(sql: string, params: Vector[Typed]) -> Result[Statement, PgError]
    val oids = params.map(p -> p.oid)
    val key = cacheKey(sql, oids)
    cache.get(key) match
      Some(s) ->
        order = order.filter(k -> k != key) :+ key
        return Ok(s)
      None -> ()
    if config.statementCacheSize == 0 then return parse("", sql, oids)
    counter += 1
    val made = parse(s"pgs_$counter", sql, oids)?
    cache = cache.updated(key, made)
    order = order :+ key
    while order.length > config.statementCacheSize
      forget(order(0))
    Ok(made)

  // Drops the cached statement under `key`; it is closed on the server with the next statement
  // prepared.
  private forget(key: string)
    cache.get(key) match
      Some(s) -> evicted = evicted :+ s.name
      None -> ()
    cache = cache.removed(key)
    order = order.filter(k -> k != key)

  // Prepares `sql` as `name` and asks what its parameters and rows are.
  private parse(name: string, sql: string, oids: Vector[int]) -> Result[Statement, PgError] =
    config.prepareTracer match
      None -> parseUntraced(name, sql, oids)
      Some(t) -> tracedPrepare(t, sql, name, pid, () -> parseUntraced(name, sql, oids))

  private parseUntraced(name: string, sql: string, oids: Vector[int]) -> Result[Statement, PgError]
    usable()?
    val out = Out()
    for old in evicted
      out.begin('C').byte1(int('S')).cstring(old).close()
    evicted = []
    out.begin('P').cstring(name).cstring(sql).int16(oids.length)
    for oid in oids
      out.int32(oid)
    out.close()
    out.begin('D').byte1(int('S')).cstring(name).close()
    out.begin('S').close()
    var paramOids: Vector[int] = []
    var columns: Vector[Column] = []
    exchange(out, (m, _) ->
      m.kind match
        '1' | '3' | 'n' -> ()
        't' ->
          val r = In(m.body)
          val n = r.int16()
          paramOids = Vector.tabulate(n, _ -> r.int32())
        'T' -> columns = describe(m)?.map(c -> c.0)
        _ -> return Err(Protocol(s"unexpected message `${m.kind}` answering Parse"))
      Ok(()))?
    Ok(Statement(name, sql, paramOids, columns))

  // Binds `params` to `statement`, runs it, and reads its rows.
  private runPrepared(statement: Statement, params: Vector[Typed]) -> Result[QueryResult, PgError]
    usable()?
    val out = Out()
    bindAndExecute(out, statement, params)?
    out.begin('S').close()
    val rows = Buffer[Row]()
    var tag = ""
    exchange(out, (m, failed) ->
      m.kind match
        '2' | 'I' | 's' -> ()
        'D' -> if !failed then rows.addOne(binaryRow(statement.columns, m)?)
        'C' -> tag = In(m.body).cstring()
        _ -> return Err(Protocol(s"unexpected message `${m.kind}` answering Execute"))
      Ok(()))?
    Ok(QueryResult(tag, rows.toVector))

  // Runs `sql`, a statement with no parameters and no rows to keep, by the simple protocol.
  private simple(sql: string) -> Result[unit, PgError]
    simpleQuery(sql)?
    Ok(())

  // ---- Talking to the server ----

  // Fails where the connection cannot be used.
  private usable() -> Result[unit, PgError] = if closed || broken then Err(Closed) else Ok(())

  // Sends `out`; a failure breaks the connection.
  private send(out: Out) -> Result[unit, PgError]
    writing = true
    val written = stream.write(out.toArray())
    writing = false
    written match
      Ok(_) -> Ok(())
      Err(e) ->
        broken = true
        Err(Io(e))

  // Fails with `e` and breaks the connection, as an answer the protocol does not allow does.
  private broke[T](e: PgError) -> Result[T, PgError]
    broken = true
    Err(e)

  // The next message, with the ones that can come at any time dealt with on the way: a notice goes
  // to the configuration's sink, a parameter's new value is kept, a notification is dropped. A
  // failure to read breaks the connection.
  private receive() -> Result[Message, PgError]
    while true
      val m = reader.next() match
        Ok(m) -> m
        Err(e) ->
          broken = true
          return Err(e)
      m.kind match
        'N' ->
          config.notices match
            Some(sink) -> sink(diagnosticOf(m))
            None -> ()
        'S' ->
          val r = In(m.body)
          val name = r.cstring()
          parameters = parameters.updated(name, r.cstring())
        'A' -> ()
        _ -> return Ok(m)
    Err(Protocol("unreachable"))

  // Sends `out` and reads the answer up to ReadyForQuery, giving each message other than an error to
  // `handle` with whether an error has already come. The first error is the answer; a protocol
  // error from `handle` breaks the connection. Where the thread is cancelled while it waits, the
  // server is asked to cancel and the answer is read to its end.
  private exchange(out: Out, handle: (Message, bool) -> Result[unit, PgError]) -> Result[unit, PgError]
    awaiting = true
    owed = 1
    unsynced = false
    defer
      if awaiting && !broken then recover()
    send(out)?
    var failure: Option[PgError] = None
    while true
      val m = receive()?
      m.kind match
        'Z' ->
          status = char(In(m.body).byte1())
          owed = 0
          awaiting = false
          return failure match
            Some(e) -> Err(e)
            None -> Ok(())
        'E' -> if failure.isEmpty then failure = Some(Server(diagnosticOf(m)))
        _ -> handle(m, failure.isDefined) match
          Ok(_) -> ()
          Err(e) ->
            broken = true
            awaiting = false
            return Err(e)
    Ok(())

  // A request's answer was left unread by a cancelled thread: asks the server to cancel the request,
  // ends a pipeline left open with a Sync, then reads the rest of the answer, up to every
  // ReadyForQuery still owed, waiting at most `DrainLimit` for each read. Where that fails, or the
  // thread was cancelled in the middle of a write, the connection is broken.
  private recover()
    awaiting = false
    if writing
      writing = false
      broken = true
      return
    cancelRequest()
    _ = stream.setTimeout(DrainLimit)
    if unsynced && send(Out().begin('S').close()).isOk then owed += 1
    unsynced = false
    while !broken && owed > 0
      reader.next() match
        Ok(m) ->
          if m.kind == 'Z'
            status = char(In(m.body).byte1())
            owed -= 1
        Err(_) -> broken = true
    owed = 0
    if stream.setTimeout(Duration(0)).isErr then broken = true

  // Asks the server, on a connection of its own, to cancel what this connection is running.
  private cancelRequest()
    TcpStream.connect(config.host, config.port) match
      Ok(side) ->
        _ = side.setTimeout(DrainLimit)
        _ = side.write(Out().beginUntyped().int32(CancelRequestCode).int32(pid).int32(secret).close().toArray())
        // The server closes the side connection once it has the request.
        _ = side.read(1)
        _ = side.close()
      Err(_) -> ()

  // ---- Startup ----

  // Sends the startup message and authenticates, up to the first ReadyForQuery.
  private startup() -> Result[unit, PgError]
    val out = Out().beginUntyped().int32(ProtocolVersion)
    out.cstring("user").cstring(config.user)
    out.cstring("database").cstring(config.database.getOrElse(config.user))
    out.cstring("client_encoding").cstring("UTF8")
    out.cstring("DateStyle").cstring("ISO")
    out.cstring("TimeZone").cstring("UTC")
    out.cstring("extra_float_digits").cstring("3")
    config.applicationName match
      Some(name) -> out.cstring("application_name").cstring(name)
      None -> ()
    out.byte1(0).close()
    send(out)?
    var scram: Option[Scram] = None
    var proven = false
    while true
      val m = receive()?
      m.kind match
        'R' ->
          val r = In(m.body)
          r.int32() match
            0 -> if scram.isDefined && !proven then return Err(
              Auth("the server accepted the password without proving it knows it")
            )
            3 ->
              auth = Cleartext
              send(Out().begin('p').cstring(password()?).close())?
            5 ->
              auth = Md5
              send(Out().begin('p').cstring(md5Answer(config.user, password()?, r.bytes(4))).close())?
            10 ->
              auth = ScramSha256
              val mechanisms = Buffer[string]()
              while r.remaining > 1
                mechanisms.addOne(r.cstring())
              if !mechanisms.contains("SCRAM-SHA-256") then return Err(
                Auth(s"the server offers ${mechanisms.mkString(", ")}, and this client speaks SCRAM-SHA-256")
              )
              val s = Scram(password()?)
              scram = Some(s)
              val first = s.first.bytes
              send(Out().begin('p').cstring("SCRAM-SHA-256").int32(first.length).raw(first).close())?
            11 ->
              val s = scram.okOr(Protocol("SASLContinue before SASL began"))?
              val answer = s.final(string.fromUtf8Lossy(r.bytes(r.remaining)))?
              send(Out().begin('p').raw(answer.bytes).close())?
            12 ->
              val s = scram.okOr(Protocol("SASLFinal before SASL began"))?
              s.verify(string.fromUtf8Lossy(r.bytes(r.remaining)))?
              proven = true
            code -> return Err(
              Auth(s"the server asks for authentication method $code, which this client does not speak")
            )
        'K' ->
          val r = In(m.body)
          pid = r.int32()
          secret = r.int32()
        'E' -> return Err(Server(diagnosticOf(m)))
        'Z' ->
          status = char(In(m.body).byte1())
          return Ok(())
        _ -> return Err(Protocol(s"unexpected message `${m.kind}` during startup"))
    Ok(())

  private password() -> Result[string, PgError] = config.password.okOr(
    Auth("the server asks for a password and none was given")
  )

// ---- Messages ----

// A RowDescription's columns, each with the format the server will send it in.
private describe(m: Message) -> Result[Vector[(Column, int)], PgError]
  val r = In(m.body)
  val n = r.int16()
  val out = Buffer[(Column, int)]()
  var i = 0
  while i < n
    val name = r.cstring()
    r.int32()
    r.int16()
    val oid = r.int32()
    r.int16()
    r.int32()
    val format = r.int16()
    out.addOne((Column(name, oid), format))
    i += 1
  if r.failed then Err(Protocol("a broken RowDescription")) else Ok(out.toVector)

// A DataRow's values, `binary` saying for each column whether it was sent in binary.
private rowOf(columns: Vector[Column], m: Message, binary: (Column) -> bool) -> Result[Row, PgError]
  val r = In(m.body)
  val n = r.int16()
  if n != columns.length then return Err(Protocol(s"a row of $n values for ${columns.length} columns"))
  val values = Buffer[PgValue]()
  var i = 0
  while i < n
    val length = r.int32()
    if length == -1
      values.addOne(PgNull)
    else
      val bytes = r.bytes(length)
      if r.failed then return Err(Protocol("a DataRow cut short"))
      val c = columns(i)
      if binary(c)
        values.addOne(decodeBinary(c.typeOid, bytes).mapErr(e -> Protocol(s"column `${c.name}`: $e"))?)
      else
        values.addOne(decodeText(c.typeOid, string.fromUtf8Lossy(bytes)))
    i += 1
  Ok(Row(columns, values.toVector))

private binaryRow(columns: Vector[Column], m: Message) -> Result[Row, PgError] = rowOf(
  columns,
  m,
  c -> binaryType(c.typeOid)
)

private textRow(columns: Vector[Column], m: Message) -> Result[Row, PgError] = rowOf(columns, m, _ -> false)

// Writes to `out` a Bind of `params` to `statement`, in the unnamed portal, and an Execute of all its
// rows. A parameter that cannot be sent as its type, or a count of them the statement does not take,
// is a `Config` error, and nothing is written.
private bindAndExecute(out: Out, statement: Statement, params: Vector[Typed]) -> Result[unit, PgError]
  if params.length != statement.paramOids.length
    return Err(Config(s"the statement has ${statement.paramOids.length} parameters and ${params.length} were given"))
  val encoded = Buffer[(bool, Option[Vector[byte]])]()
  var i = 0
  while i < params.length
    encoded.addOne(encodeFor(statement.paramOids(i), params(i).value).mapErr(e -> Config(s"parameter $$${i + 1}: $e"))?)
    i += 1
  out.begin('B').cstring("").cstring(statement.name)
  out.int16(encoded.length)
  for (binary, _) in encoded
    out.int16(if binary then 1 else 0)
  out.int16(encoded.length)
  for (_, bytes) in encoded
    bytes match
      Some(b) -> out.int32(b.length).raw(b)
      None -> out.int32(-1)
  out.int16(statement.columns.length)
  for c in statement.columns
    out.int16(if binaryType(c.typeOid) then 1 else 0)
  out.close()
  out.begin('E').cstring("").int32(0).close()
  Ok(())

// Writes to `out` the messages that run `plan` unprepared: a Parse of the unnamed statement, a Bind of
// `params` as text with every column asked for as text, a Describe of the portal, so the rows can be
// read, and an Execute.
private parseAndExecute(out: Out, plan: Plan, params: Vector[Typed]) -> Result[unit, PgError]
  val texts = Buffer[Option[Vector[byte]]]()
  var i = 0
  while i < params.length
    val v = params(i).value
    texts.addOne(if v == PgNull then None else Some(textOf(v).mapErr(e -> Config(s"parameter $$${i + 1}: $e"))?.bytes))
    i += 1
  out.begin('P').cstring("").cstring(plan.sql).int16(plan.oids.length)
  for oid in plan.oids
    out.int32(oid)
  out.close()
  out.begin('B').cstring("").cstring("").int16(0).int16(texts.length)
  for t in texts
    t match
      Some(b) -> out.int32(b.length).raw(b)
      None -> out.int32(-1)
  out.int16(0).close()
  out.begin('D').byte1(int('P')).cstring("").close()
  out.begin('E').cstring("").int32(0).close()
  Ok(())

// A parameter's value as type `oid` goes in a Bind: in binary where the client writes that type so,
// as text otherwise, and `None` for NULL.
private encodeFor(oid: int, v: PgValue) -> Result[(bool, Option[Vector[byte]]), string]
  if v == PgNull then return Ok((false, None))
  if binaryType(oid)
    encodeBinary(oid, v) match
      Some(bytes) -> return Ok((true, Some(bytes)))
      None -> ()
  Ok((false, Some(textOf(v)?.bytes)))

// The fields of an ErrorResponse or a NoticeResponse.
private diagnosticOf(m: Message) -> Diagnostic
  val r = In(m.body)
  var d = Diagnostic("", "", "")
  var localized = ""
  while r.remaining > 0
    val code = r.byte1()
    if code == 0 then return finished(d, localized)
    val text = r.cstring()
    d = char(code) match
      'S' ->
        localized = text
        d
      'V' -> d with {severity = text}
      'C' -> d with {code = text}
      'M' -> d with {message = text}
      'D' -> d with {detail = Some(text)}
      'H' -> d with {hint = Some(text)}
      'P' -> d with {position = text.toIntOption()}
      'p' -> d with {internalPosition = text.toIntOption()}
      'q' -> d with {internalQuery = Some(text)}
      'W' -> d with {where = Some(text)}
      's' -> d with {schema = Some(text)}
      't' -> d with {table = Some(text)}
      'c' -> d with {column = Some(text)}
      'd' -> d with {dataType = Some(text)}
      'n' -> d with {constraint = Some(text)}
      'F' -> d with {file = Some(text)}
      'L' -> d with {line = text.toIntOption()}
      'R' -> d with {routine = Some(text)}
      _ -> d
  finished(d, localized)

// The severity is the unlocalized one where the server sends it (9.6 and later), the localized one
// otherwise.
private finished(
    d: Diagnostic,
    localized: string
) -> Diagnostic = if d.severity == "" then d with {severity = localized} else d

// ---- Connecting ----

// A connection made with the settings of the URL `url` (`PgConfig.parse`).
connect(url: string) -> Result[Connection, PgError] = Connection.connect(PgConfig.parse(url)?)

// A connection made with `config`. With `Prefer`, TLS is asked for; where the server does not offer
// it, or its certificate does not verify, the connection is plain.
connect(config: PgConfig) -> Result[Connection, PgError] = Connection.connect(config)

object Connection
  // A connection made with `config`, as the module's `connect` makes it.
  connect(config: PgConfig) -> Result[Connection, PgError] = config.connectTracer match
    None -> negotiated(config)
    Some(t) -> tracedConnect(t, config, () -> negotiated(config))

  // A connection over TLS or plain TCP as `config.sslMode` asks.
  private negotiated(config: PgConfig) -> Result[Connection, PgError] = config.sslMode match
    Disable -> open(config, false)
    Require -> open(config, true)
    Prefer -> open(config, true) match
      Err(Tls(_)) -> open(config, false)
      other -> other

  // A connection over TCP, over TLS where `tls` (or plain, under `Prefer`, where the server will
  // not speak TLS), started and authenticated.
  private open(config: PgConfig, tls: bool) -> Result[Connection, PgError]
    val tcp = TcpStream.connect(config.host, config.port).mapErr(e -> Io(e))?
    config.connectTimeout match
      Some(d) -> _ = tcp.setTimeout(d)
      None -> ()
    over(tcp, config, tls) match
      Ok(c) ->
        c.startup() match
          Ok(_) ->
            _ = c.stream.setTimeout(Duration(0))
            Ok(c)
          Err(e) ->
            _ = c.stream.close()
            Err(e)
      Err(e) ->
        _ = tcp.close()
        Err(e)

  private over(tcp: TcpStream, config: PgConfig, tls: bool) -> Result[Connection, PgError]
    if !tls then return Ok(Connection(tcp, config, false))
    tcp.write(Out().beginUntyped().int32(SslRequestCode).close().toArray()).mapErr(e -> Io(e))?
    val answer = tcp.read(1).mapErr(e -> Io(e))?
    if answer.length == 0 then return Err(
      Io(IoError(io.ConnectionReset, "read from", s"${config.host}:${config.port}"))
    )
    char(int(answer(0))) match
      'S' ->
        val settings = config.rootCertificate match
          Some(pem) -> TlsClient().trust(pem)
          None -> TlsClient()
        val secured = TlsStream.client(tcp, config.host, settings).mapErr(e -> Tls(e))?
        Ok(Connection(secured, config, true))
      'N' -> if config.sslMode == Require then Err(TlsRefused) else Ok(Connection(tcp, config, false))
      c -> Err(Protocol(s"the server answered the TLS request with `$c`"))
